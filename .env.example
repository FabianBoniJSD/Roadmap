# =============================================================================
# Next.js Roadmap - Environment Configuration (Current)
# =============================================================================
# Copy to .env.local (development) or .env.production (server).
# Do not commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment / Runtime
# -----------------------------------------------------------------------------
# Used for SharePoint URL and basePath selection.
# Recommended values: development | production
NEXT_PUBLIC_DEPLOYMENT_ENV=development
NODE_ENV=development

# Base paths (leave empty when hosted at root).
NEXT_PUBLIC_BASE_PATH_DEV=
NEXT_PUBLIC_BASE_PATH_PROD=/roadmap

# SharePoint web URL per deployment environment.
NEXT_PUBLIC_SHAREPOINT_SITE_URL_DEV=https://your-sharepoint-dev.domain.com/sites/yoursite
NEXT_PUBLIC_SHAREPOINT_SITE_URL_PROD=https://your-sharepoint-prod.domain.com/sites/yoursite
# Optional global SharePoint web and connection overrides for directory-wide People Picker search.
# Falls back to NEXT_PUBLIC_SHAREPOINT_SITE_URL_DEV/PROD and SP_STRATEGY/SP_TRUSTED_CA_PATH.
SP_PEOPLE_PICKER_SITE_URL=
SP_PEOPLE_PICKER_STRATEGY=
SP_PEOPLE_PICKER_TRUSTED_CA_PATH=
# Roadmap instance whose working SharePoint web is used as the tenant-directory API entry point.
# This does not change authorization: users are still checked against the active instance.
SP_PEOPLE_PICKER_INSTANCE_SLUG=bdm-projekte
# Deployment smoke-test target and directory query.
SP_PEOPLE_PICKER_SMOKE_INSTANCE=sanitaet
SP_PEOPLE_PICKER_SMOKE_QUERY=fabian

# Optional server-side absolute app URL for internal fetch calls.
INTERNAL_API_BASE_URL=http://localhost:3000
# Separate HMAC key for server-to-server API calls (>= 32 random characters).
INTERNAL_API_SECRET=
# Canonical public origin used for same-origin checks. Comma-separated values are supported.
APP_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Maintenance
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_MESSAGE=""
NEXT_PUBLIC_MAINTENANCE_TIME="30"

# -----------------------------------------------------------------------------
# AI endpoint heartbeat
# -----------------------------------------------------------------------------
# Server-only JSON. Use a non-billable GET/HEAD health or models endpoint.
AI_HEARTBEAT_ENDPOINTS='[{"id":"primary-ai","label":"Primärer KI-Dienst","url":"https://ai.example.internal/health","method":"GET","timeoutMs":5000}]'
# If true, missing endpoint configuration is reported as an outage.
AI_HEARTBEAT_REQUIRED=false
# Shared server-side result cache; avoids one upstream request per browser tab.
AI_HEARTBEAT_CACHE_TTL_MS=15000
# Production HTTP endpoints are rejected unless this explicit exception is enabled.
AI_HEARTBEAT_ALLOW_HTTP=false
# Optional client polling and copy overrides (embedded during the Next.js build).
NEXT_PUBLIC_AI_HEARTBEAT_INTERVAL_MS=30000
NEXT_PUBLIC_AI_HEARTBEAT_REQUEST_TIMEOUT_MS=12000
NEXT_PUBLIC_AI_HEARTBEAT_MESSAGE="Die KI-Dienste sind momentan nicht erreichbar. KI-Funktionen stehen vorübergehend nicht zur Verfügung."

# -----------------------------------------------------------------------------
# Database / Instance
# -----------------------------------------------------------------------------
# PostgreSQL service; URL-encode reserved characters in the password.
DATABASE_URL="postgresql://roadmap:replace-with-a-strong-password@postgres.example.internal:5432/roadmap?schema=public"

# Optional: cache TTL for instance config resolution (milliseconds).
INSTANCE_CACHE_TTL_MS=30000

# Optional: Prisma logging detail (set to debug for SQL query logs).
PRISMA_LOG_LEVEL=error

# -----------------------------------------------------------------------------
# SharePoint Authentication (Current Standard)
# -----------------------------------------------------------------------------
# Kerberos service account used by /api/sharepoint proxy.
# Use DOMAIN\username format.
SP_KERBEROS_SERVICE_USER=
SP_KERBEROS_SERVICE_PASSWORD=

# Optional legacy credential fallback (kept for compatibility paths/tools).
SP_USERNAME=
SP_PASSWORD=
USER_NAME=
USER_PASSWORD=

# Optional domain hint for certain on-prem parsing paths.
SP_ONPREM_DOMAIN=
# Optional explicit Kerberos realm for Linux kinit (for example: EXAMPLE.COM).
# If unset, the realm is derived from SP_ONPREM_DOMAIN or DOMAIN\\username.
SP_KERBEROS_REALM=

# Optional legacy auth mode overrides (normally not required).
# If unset, runtime defaults to kerberos.
# SP_STRATEGY=kerberos
# NEXT_PUBLIC_SP_AUTH_MODE=kerberos

# Only enable delegated mode behind a trusted reverse proxy that removes client-supplied identity
# headers and injects an authenticated user plus a Negotiate Authorization header. Its exact
# socket address must also be present in TRUSTED_PROXY_ADDRESSES.
SP_TRUST_DELEGATED_PROXY=false

# -----------------------------------------------------------------------------
# SharePoint Proxy Behavior / Diagnostics
# -----------------------------------------------------------------------------
# Enable verbose SharePoint proxy logs.
SP_PROXY_DEBUG=false

# Keep in-memory curl GET cache for N seconds.
SP_CURL_CACHE_SECONDS=60

# If kerberos curl call returns 401, allow NTLM retry.
# Set to false only for strict debugging.
SP_CURL_NTLM_FALLBACK=true

# Optional debug-only delay before NTLM fallback is attempted.
# In normal runtime the proxy now forces immediate fallback after the first 401.
# Raise this only temporarily together with SP_PROXY_DEBUG=true.
# SP_KERBEROS_NTLM_FALLBACK_AFTER_401S=1

# Allow fallback from curl path to fetch path when curl fails.
SP_CURL_FALLBACK_TO_FETCH=false

# Enable curl verbose output in proxy logs.
SP_CURL_VERBOSE=false

# Decode %24select -> $select in forwarded SharePoint query strings.
SP_DECODE_DOLLAR=false

# Disable undici dispatcher usage for fetch fallback troubleshooting.
SP_DISABLE_DISPATCHER=false

# Disable auth-related cache decisions in instance config.
SP_AUTH_NO_CACHE=false

# -----------------------------------------------------------------------------
# TLS / Proxy Networking
# -----------------------------------------------------------------------------
# These legacy switches must remain false; startup rejects insecure TLS.
SP_ALLOW_SELF_SIGNED=false
SP_TLS_FALLBACK_INSECURE=false

# Optional path to custom trusted CA certificate file.
SP_TRUSTED_CA_PATH=

# Optional custom proxy agent for outbound requests.
SP_CUSTOM_PROXY_AGENT=false

# Optional outbound proxy settings.
# HTTP_PROXY=http://proxy-host:port
# HTTPS_PROXY=http://proxy-host:port

# Optional Node trust-store extension. Never disable certificate verification.
# NODE_EXTRA_CA_CERTS=

# -----------------------------------------------------------------------------
# Admin Auth / Public API
# -----------------------------------------------------------------------------
# Required for JWT-based admin session tokens.
# Use a long random secret (>= 32 chars).
JWT_SECRET=your-secure-random-string-here-minimum-32-characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=roadmap-sharepoint
JWT_AUDIENCE=roadmap-web
# Increment to invalidate every existing application session immediately.
JWT_SESSION_VERSION=1

# Optional API keys for /api/public/projects.
# Comma-separated keys, each at least 32 characters. Send only via Bearer or X-API-Key headers.
PUBLIC_PROJECTS_API_KEYS=

# Optional single-key alias for GitHub Actions secret injection.
# If set, runtime accepts it the same way as PUBLIC_PROJECTS_API_KEYS.
ROADMAP_API_KEY=

# -----------------------------------------------------------------------------
# Microsoft Entra ID SSO (Optional)
# -----------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
# Optional absolute URL registered in Entra for the redirect after central logout.
ENTRA_POST_LOGOUT_REDIRECT_URI=

# Reserved legacy settings. The current Entra callback does not read these values.
# Authentication currently accepts every uniquely identified user in the configured tenant;
# application roles are resolved separately on the server.
ENTRA_ADMIN_UPNS=

# Reserved legacy setting; this does not grant admin access.
ENTRA_ALLOW_ALL=false

# Auto-redirect to Entra login on /admin/login.
NEXT_PUBLIC_ENTRA_AUTO_LOGIN=false

# -----------------------------------------------------------------------------
# UI / App Debug
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEBUG_AUTH=false
NEXT_PUBLIC_DEBUG_EXPOSE=0
# Dedicated sensitive diagnostics stay unavailable unless this is explicitly true.
ENABLE_SECURITY_DEBUG_ENDPOINTS=false

# Show maintenance banner to all users.
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_MESSAGE=Roadmap is currently in maintenance mode.

# Silence Next.js config log lines during build/start.
SUPPRESS_CONFIG_LOG=0

# Disable telemetry in CI/servers.
NEXT_TELEMETRY_DISABLED=1

# Short-lived server caches collapse duplicate SharePoint and authorization reads.
ROADMAP_DATA_CACHE_TTL_MS=60000
ROADMAP_DATA_STALE_TTL_MS=300000
ROADMAP_ACCESS_CACHE_TTL_MS=60000
ROADMAP_ACCESS_DENIED_CACHE_TTL_MS=15000
ROADMAP_MIRRORING_CACHE_TTL_MS=60000
ROADMAP_MIRRORING_CONCURRENCY=3
ROADMAP_APP_SETTINGS_CACHE_TTL_MS=60000

# -----------------------------------------------------------------------------
# Document Storage
# -----------------------------------------------------------------------------
# Maximum accepted document size in bytes (default: 26214400 = 25 MB).
ROADMAP_DOCUMENT_MAX_BYTES=26214400
# Maximum body accepted by the internal SharePoint proxy (default: 31457280 = 30 MB).
SP_PROXY_MAX_BODY_BYTES=31457280
# Required malware scanner. Uploads fail closed when it is unavailable.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Only requests arriving from these exact proxy IPs may use X-Forwarded-For for rate limiting.
TRUSTED_PROXY_ADDRESSES=

# -----------------------------------------------------------------------------
# Super Admin Scope (Optional)
# -----------------------------------------------------------------------------
# Limit super admin checks to specific instances.
# Use comma-separated list or "all" / "*".
SUPERADMIN_INSTANCE_SLUGS=
SUPERADMIN_INSTANCE_SLUG=

# =============================================================================
# Security Notes
# =============================================================================
# 1) Never commit .env.local / .env.production.
# 2) Use dedicated service accounts with least privilege.
# 3) Rotate SP and JWT secrets regularly.
# 4) Prefer external secret stores for production.
# =============================================================================
