{
  "name": "roadmap-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev --turbo",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,mjs}\"",
    "perf:budget": "node scripts/check-performance-budgets.mjs",
    "security:audit": "yarn audit --level moderate",
    "test:security": "node scripts/run-security-tests.mjs",
    "smoke:people-picker": "node scripts/smoke-test-sharepoint-people-picker.mjs",
    "smoke:kerberos": "tsx scripts/verify-kerberos-ticket.ts",
    "smoke:contextinfo": "node scripts/smoke-test-sharepoint-contextinfo.mjs",
    "pre-commit": "lint-staged --concurrent false",
    "pm2:restart": "pm2 startOrRestart ecosystem.config.js --only roadmap-app --update-env",
    "pm2:stop": "pm2 delete roadmap-app",
    "pm2:logs": "pm2 logs roadmap-app",
    "pm2:status": "pm2 status",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@fluentui/react": "^8.121.2",
    "@mui/x-internal-exceljs-fork": "5.0.0",
    "@prisma/client": "^5.20.0",
    "@roadmap/entra-sso": "0.1.0",
    "@types/node": "20.11.30",
    "@types/sanitize-html": "^2.16.1",
    "@xmldom/xmldom": "^0.9.5",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "https-proxy-agent": "^7.0.6",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "next": "15.5.21",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-datepicker": "^6.0.0",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "sanitize-html": "2.17.5",
    "undici": "^6.28.0"
  },
  "resolutions": {
    "xmldom": "npm:@xmldom/xmldom@^0.9.5",
    "jsonwebtoken": "^9.0.2",
    "tough-cookie": "^4.1.4",
    "cookie": "^0.7.2",
    "got": "^11.8.6",
    "js-yaml": "4.3.0",
    "sharp": "0.35.3",
    "postcss": "8.5.26",
    "uuid": "11.1.1",
    "pm2/ws": "8.21.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@types/xmldom": "^0.1.34",
    "autoprefixer": "10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "pm2": "7.0.0",
    "postcss": "8.5.26",
    "prettier": "^3.4.2",
    "prisma": "^5.20.0",
    "tailwindcss": "3.4.9",
    "tsx": "^4.23.1",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
