generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RoadmapInstance {
  id                    Int                   @id @default(autoincrement())
  slug                  String                @unique
  displayName           String
  department            String?
  description           String?
  sharePointSiteUrlDev  String
  sharePointSiteUrlProd String?
  sharePointStrategy    String                @default("kerberos")
  allowSelfSigned       Boolean               @default(false)
  trustedCaPath         String?
  deploymentEnv         String?
  defaultLocale         String?
  defaultTimeZone       String?
  landingPage           String?               @unique
  settingsJson          String?
  spHealthJson          String?
  spHealthCheckedAt     DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  hosts                 RoadmapInstanceHost[]
}

model RoadmapInstanceHost {
  id         Int             @id @default(autoincrement())
  host       String          @unique
  instance   RoadmapInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model SuperAdmin {
  id                 Int      @id @default(autoincrement())
  username           String
  normalizedUsername String   @unique
  isActive           Boolean  @default(true)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model InstanceDepartmentAccess {
  id                   Int      @id @default(autoincrement())
  instanceSlug         String
  department           String
  normalizedDepartment String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([instanceSlug, normalizedDepartment])
  @@index([instanceSlug])
}

model FeedbackRequest {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  createdBy     String
  createdByName String?
  status        String         @default("OPEN")
  completedAt   DateTime?
  completedBy   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  votes         FeedbackVote[]

  @@index([createdAt])
  @@index([status, completedAt])
}

model FeedbackVote {
  id         Int             @id @default(autoincrement())
  feedbackId Int
  userKey    String
  value      Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  request    FeedbackRequest @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userKey])
  @@index([userKey])
}

/// Retired local-chat archive. No active chat route reads or writes this model.
model SupportConversation {
  id                String           @id @default(cuid())
  visitorTokenHash  String           @unique
  visitorName       String?
  visitorUserKey    String?
  instanceSlug      String?
  status            String           @default("OPEN")
  supportLastReadAt DateTime?
  lastMessageAt     DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  messages          SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([instanceSlug, lastMessageAt])
}

/// Retained with SupportConversation to preserve historical records.
model SupportMessage {
  id             Int                 @id @default(autoincrement())
  conversationId String
  senderRole     String
  senderName     String?
  body           String
  createdAt      DateTime            @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model RateLimitBucket {
  scope     String
  keyHash   String
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@id([scope, keyHash])
  @@index([resetAt])
}

model AuthSession {
  id        String    @id
  userKey   String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([userKey, revokedAt])
}

/// Append-only record of a successful user-initiated mutation. Audit events only
/// contain an explicit, small metadata set; request bodies, headers and query
/// parameters must never be persisted here.
model AuditEvent {
  id               String   @id @default(cuid())
  action           String
  entityType       String
  entityId         String?
  entityLabel      String?
  actorKey         String
  actorDisplayName String?
  actorSource      String?
  instanceSlug     String?
  visibility       String   @default("instance")
  requestMethod    String
  requestPath      String?
  occurredAt       DateTime @default(now())

  @@index([occurredAt])
  @@index([instanceSlug, occurredAt])
  @@index([visibility, occurredAt])
  @@index([actorKey, occurredAt])
}
